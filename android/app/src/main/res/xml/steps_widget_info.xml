<?xml version="1.0" encoding="utf-8"?>
<!-- Mały widget 2×2. Odświeżanie co 30 min (minimum w Androidzie) + przy każdym odczycie kroków w aplikacji. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_steps_description"
    android:initialLayout="@layout/widget_steps"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:previewLayout="@layout/widget_steps"
    android:resizeMode="none"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
